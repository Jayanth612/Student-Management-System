# ---------- ROUTES ----------
@app.route("/")
def home():
    return html_page

@app.route("/detect", methods=["POST"])
def detect():
    data = request.json
    text = data.get("text", "")
    result = predict_fake_news(text)
    return jsonify({"result": result})

# ---------- RUN SERVER ----------
if __name__ == "__main__":
    app.run(debug=True)
